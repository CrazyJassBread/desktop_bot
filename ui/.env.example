# Web app. Use 0.0.0.0 so phones and hardware on the same Wi-Fi can reach it.
HOST=0.0.0.0
PORT=18000
PUBLIC_APP_URL=http://192.168.1.20:18000

# LAN backend. Put only the backend origin here; paths are configured separately.
# Example: backend device/computer is 192.168.1.50 and listens on port 8000.
BACKEND_BASE_URL=http://192.168.1.50:8000
BACKEND_API_TOKEN=
BACKEND_TRANSCRIBE_PATH=/api/transcriptions
BACKEND_PRINT_PATH=/api/print-jobs

# Server-only DeepSeek configuration. Never put this key in public/app.js.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Desktop bot device bridge. The bot posts finished letters here; the token
# must match ui.device_token in the bot's config/ui.yaml. The email selects
# which account owns letters coming from the device.
DEVICE_API_TOKEN=bot-device-token
DEVICE_USER_EMAIL=hello@aihub.local

# Persistence and session security.
DATABASE_PATH=./data/ai-hub.sqlite
COOKIE_SECURE=false
