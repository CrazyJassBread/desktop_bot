# 留空使用系统默认麦克风。运行 ./run-local.sh --list-mics 可查看设备。
MICROPHONE_DEVICE=

# 1 = 使用电脑摄像头模拟 Bot 图像；可指定摄像头编号。
CAMERA_ENABLED=1
CAMERA_DEVICE=0

# 1 = 不操作真实打印机/OLED；连接真实 Bot 后改为 0。
GATEWAY_DRY_RUN=1

# 1 = 按 Ctrl+C 时同时停止 Docker 服务；0 = 保持后台运行。
AUTO_STOP_ON_EXIT=1

# 本地默认值通常无需修改。
# 留空时自动使用本地 Cloud 服务的实际端口。
BOT_CLOUD_URL=
BOT_GATEWAY_TOKEN=local-gateway-token-change-me
# 可选；默认使用电脑主机名。每台电脑应保持唯一且稳定。
BOT_GATEWAY_ID=
AI_HUB_BRIDGE_TOKEN=local-web-bridge-token-change-me

# 可选。端口被其他程序占用时，启动脚本也会自动寻找后续可用端口。
WEB_HOST_PORT=18000
CLOUD_HOST_PORT=8090
