# Browser-facing web/API server.
HOST=0.0.0.0
PORT=18000
PUBLIC_APP_URL=http://127.0.0.1:18000
DATABASE_PATH=./data/ai-hub.sqlite
COOKIE_SECURE=false

# Raw audio TCP listener. One connection is one utterance; closing the write
# side marks the end. Audio must be 16 kHz, mono, signed PCM16 little-endian.
TRANSCRIPTION_TCP_HOST=0.0.0.0
TRANSCRIPTION_TCP_PORT=8080
# 720 seconds of PCM16/16kHz mono is about 23 MB, leaving room below a 25 MB upload ceiling.
TRANSCRIPTION_MAX_SECONDS=720
TRANSCRIPTION_IDLE_TIMEOUT_MS=15000
TRANSCRIPTION_REQUEST_TIMEOUT_MS=120000
TRANSCRIPTION_CONCURRENCY=4
TRANSCRIPTION_VAD_THRESHOLD=500
TRANSCRIPTION_VAD_SILENCE_MS=1200
TRANSCRIPTION_STOP_GRACE_MS=2000

# Raw 640x480 JPEG receiver used by the firmware camera.
VISION_HTTP_HOST=0.0.0.0
VISION_HTTP_PORT=8081

# OpenAI transcription (server only).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# DeepSeek summary and letter generation (server only).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ESP bitmap printer. Keep PRINTER_AUTO_SEND=false until the IP is verified.
ESP_PRINTER_BASE_URL=http://10.76.0.126
PRINTER_AUTO_SEND=false
PRINTER_TIMEOUT_MS=30000
PRINTER_ROTATE_180=true

# OLED status display. Defaults to ESP_PRINTER_BASE_URL when omitted.
ESP_OLED_BASE_URL=http://192.168.1.100
OLED_TIMEOUT_MS=5000
