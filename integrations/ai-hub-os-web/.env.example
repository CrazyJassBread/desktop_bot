# Server-only AI configuration. Never expose real keys to browser code.
DEEPSEEK_API_KEY=replace-with-your-server-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Local ESP32 thermal printer. The browser never calls this address directly.
ESP_PRINTER_BASE_URL=http://10.76.10.141

# Web app.
PORT=18000
HOST=127.0.0.1
