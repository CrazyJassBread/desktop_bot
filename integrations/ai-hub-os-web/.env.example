# Server-only AI configuration. Never expose real keys to browser code.
DEEPSEEK_API_KEY=replace-with-your-server-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Local ESP32 thermal printer.
ESP_PRINTER_BASE_URL=http://10.76.7.129

# Web app.
PORT=18000
HOST=127.0.0.1
AI_HUB_INTERNAL_URL=http://127.0.0.1:18000

# desktop_bot hardware perception bridge.
DESKTOP_BOT_BASE_URL=http://127.0.0.1:8090
DESKTOP_BOT_WEBSOCKET_PATH=/api/events
DESKTOP_BOT_BRIDGE_ENABLED=true

# Reserved hardware ports:
# - audio TCP PCM: 8081
# - image HTTP upload: 8082
